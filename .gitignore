# The ComfyUI runtime is a separate nested checkout with model weights,
# custom nodes, a virtual environment, and user data. Recreate it with the
# setup scripts; do not vendor it in this workflow repository.
/ComfyUI/

# Generated runtime state and logs
logs/
outputs/
output/
temp/
tmp/
cache/
*.log
*.db
*.sqlite
*.sqlite3

# Project-local production artifacts and execution state
/plan/
/compiled/
/orchestrator/runs/
/orchestrator/state/

# Temporary development documents
/TEMP_*

