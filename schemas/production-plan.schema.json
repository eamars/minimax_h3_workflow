{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "production-plan.schema.json",
  "type": "object",
  "required": ["artifact", "request_summary", "asset_reference_map", "canon", "plot", "scene_performance", "sound", "director_treatment", "shots", "generation_segments", "timelines", "handoffs", "pacing", "risks", "dependencies", "provisional_h3_modes", "provisional_workflow_classes", "acceptance_criteria", "open_decisions", "preflight", "rerender_exposure"],
  "properties": {
    "artifact": {"$ref": "common-defs.schema.json#/$defs/artifact"},
    "generation_segments": {"type": "array", "minItems": 1, "items": {"$ref": "common-defs.schema.json#/$defs/generationSegment"}},
    "dependencies": {"type": "array", "items": {"type": "object", "required": ["from", "to", "reason"]}}
  },
  "additionalProperties": true
}
