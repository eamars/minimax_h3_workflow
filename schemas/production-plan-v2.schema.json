{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "production-plan-v2.schema.json",
  "type": "object",
  "required": ["artifact", "planning_model_version", "request_summary", "asset_reference_map", "canon", "plot", "scene_performance", "sound", "director_treatment", "scene_geography", "shots", "generation_segments", "editorial_boundaries", "generation_handoffs", "continuity_registry", "animatic_intent", "creative_acceptance_tests", "timelines", "pacing", "risks", "dependencies", "provisional_h3_modes", "provisional_workflow_classes", "acceptance_criteria", "open_decisions", "preflight", "rerender_exposure", "approval"],
  "properties": {
    "artifact": {"$ref": "common-defs.schema.json#/$defs/artifact"},
    "planning_model_version": {"const": 2},
    "request_summary": {"type": "object"},
    "asset_reference_map": {"type": "object"},
    "canon": {"type": "object"},
    "plot": {"type": "object"},
    "scene_performance": {"type": "object"},
    "sound": {"type": "object"},
    "director_treatment": {"type": "object"},
    "scene_geography": {"$ref": "common-defs.schema.json#/$defs/sceneGeography"},
    "shots": {"type": "array", "minItems": 1, "items": {"$ref": "storyboard-package-v2.schema.json#/properties/shots/items"}},
    "generation_segments": {"type": "array", "minItems": 1, "items": {"$ref": "common-defs.schema.json#/$defs/generationSegmentV2"}},
    "editorial_boundaries": {"type": "array", "minItems": 1, "items": {"$ref": "common-defs.schema.json#/$defs/editorialBoundary"}},
    "generation_handoffs": {"type": "array", "items": {"$ref": "common-defs.schema.json#/$defs/generationHandoff"}},
    "continuity_registry": {"type": "array", "items": {"$ref": "common-defs.schema.json#/$defs/continuityState"}},
    "animatic_intent": {"type": "object", "required": ["scene_time_policy", "record_time_policy", "pacing_notes"]},
    "creative_acceptance_tests": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["test_id", "scope", "assertion"]}},
    "timelines": {"type": "object"},
    "pacing": {"type": "object"},
    "risks": {"type": "array"},
    "dependencies": {"type": "array", "items": {"type": "object", "required": ["from", "to", "reason"]}},
    "provisional_h3_modes": {"type": "array"},
    "provisional_workflow_classes": {"type": "array"},
    "acceptance_criteria": {"type": "array", "minItems": 1},
    "open_decisions": {"type": "array"},
    "preflight": {"type": "object"},
    "rerender_exposure": {"type": "object"},
    "approval": {
      "type": "object",
      "required": ["plan_id", "plan_version", "plan_hash", "status", "approved_by", "approved_at", "approved_scope", "conditions"],
      "properties": {
        "plan_id": {"type": "string", "minLength": 1},
        "plan_version": {"type": "integer", "minimum": 1},
        "plan_hash": {"$ref": "common-defs.schema.json#/$defs/sha256"},
        "status": {"enum": ["pending", "approved", "rejected", "revision_requested"]},
        "approved_by": {"type": ["string", "null"]},
        "approved_at": {"type": ["string", "null"]},
        "approved_scope": {"type": "array"},
        "conditions": {"type": "array"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
