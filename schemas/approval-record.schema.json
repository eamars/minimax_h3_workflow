{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "approval-record.schema.json",
  "type": "object",
  "required": ["plan_id", "plan_version", "plan_hash", "status", "approved_by", "approved_at", "approved_scope", "conditions"],
  "properties": {
    "plan_id": {"type": "string"},
    "plan_version": {"type": "integer", "minimum": 1},
    "plan_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "status": {"enum": ["pending", "approved", "rejected", "revision_requested"]},
    "approved_by": {"type": ["string", "null"]},
    "approved_at": {"type": ["string", "null"]},
    "approved_scope": {"type": "array"},
    "conditions": {"type": "array"}
  }
}
