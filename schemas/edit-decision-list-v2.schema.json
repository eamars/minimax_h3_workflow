{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "edit-decision-list-v2.schema.json",
  "type": "object",
  "required": ["artifact", "planning_model_version", "project_id", "fps", "events", "editorial_boundaries", "sound_boundary_map"],
  "properties": {
    "artifact": {"$ref": "common-defs.schema.json#/$defs/artifact"},
    "planning_model_version": {"const": 2},
    "project_id": {"type": "string", "pattern": "^PRJ[0-9]{2,}$"},
    "fps": {"type": "number", "exclusiveMinimum": 0},
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["event_id", "shot_id", "segment_ids", "source_time", "record_time", "boundary_in_id", "boundary_out_id", "audio_rules"],
        "properties": {
          "event_id": {"type": "string", "minLength": 1},
          "shot_id": {"type": "string", "minLength": 1},
          "segment_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "source_time": {"$ref": "common-defs.schema.json#/$defs/cinematicTimeRange"},
          "record_time": {"$ref": "common-defs.schema.json#/$defs/cinematicTimeRange"},
          "boundary_in_id": {"type": ["string", "null"]},
          "boundary_out_id": {"type": ["string", "null"]},
          "audio_rules": {"type": "object"}
        },
        "additionalProperties": false
      }
    },
    "editorial_boundaries": {"type": "array", "minItems": 1, "items": {"$ref": "common-defs.schema.json#/$defs/editorialBoundary"}},
    "sound_boundary_map": {"type": "array", "items": {"type": "object", "required": ["boundary_id", "picture_edit", "audio_edit", "cue_ids"], "properties": {"boundary_id": {"type": "string"}, "picture_edit": {"enum": ["cut", "dissolve", "fade", "end"]}, "audio_edit": {"enum": ["independent", "j_cut", "l_cut", "hard_sync"]}, "overlap_frames": {"type": "integer", "minimum": 0}, "pre_roll_frames": {"type": "integer", "minimum": 0}, "post_roll_frames": {"type": "integer", "minimum": 0}, "cue_ids": {"type": "array"}}, "additionalProperties": false}}
  },
  "additionalProperties": false
}
