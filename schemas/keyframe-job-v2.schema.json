{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "keyframe-job-v2.schema.json",
  "type": "object",
  "required": ["artifact", "planning_model_version", "job_id", "segment_id", "shot_id", "endpoint", "source_type", "generation_relationship", "endpoint_policy", "motion_endpoint_evidence", "normalization", "approval_status", "output_path"],
  "properties": {
    "artifact": {"$ref": "common-defs.schema.json#/$defs/artifact"},
    "planning_model_version": {"const": 2},
    "job_id": {"type": "string"},
    "segment_id": {"type": "string"},
    "shot_id": {"type": "string"},
    "endpoint": {"enum": ["in", "out"]},
    "source_type": {"enum": ["user_seed", "approved_tail", "approved_target_still_job"]},
    "generation_relationship": {"enum": ["independent", "same_shot_continue", "endpoint_bridge", "reference_reestablish", "terminal"]},
    "endpoint_policy": {"enum": ["none", "moving_endpoint", "stable_tail", "approved_entry_reference", "bridge_endpoints"]},
    "motion_endpoint_evidence": {"type": "object", "required": ["source_tail", "successor_entry", "comparison_fields"]},
    "normalization": {"type": "object", "required": ["width", "height", "color_format", "composition_rule"]},
    "approval_status": {"enum": ["pending", "approved", "rejected"]},
    "output_path": {"type": "string"}
  },
  "additionalProperties": false
}
