{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "production-dag-v2.schema.json",
  "type": "object",
  "required": ["artifact", "planning_model_version", "plan_hash", "generation_nodes", "generation_edges", "editorial_boundary_ids", "post_edges"],
  "properties": {
    "artifact": {"$ref": "common-defs.schema.json#/$defs/artifact"},
    "planning_model_version": {"const": 2},
    "plan_hash": {"$ref": "common-defs.schema.json#/$defs/sha256"},
    "generation_nodes": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["segment_id", "job_id", "state", "shot_id", "generation_relationship"]}},
    "generation_edges": {"type": "array", "items": {"type": "object", "required": ["from", "to", "relation"], "properties": {"relation": {"enum": ["asset", "approval", "same_shot_continue", "endpoint_bridge", "reference_reestablish", "terminal"]}}, "additionalProperties": false}},
    "editorial_boundary_ids": {"type": "array", "items": {"type": "string"}},
    "post_edges": {"type": "array", "items": {"type": "object", "required": ["from", "to", "relation"], "properties": {"relation": {"enum": ["concat", "audio_mix", "upscale", "final_export"]}}, "additionalProperties": false}}
  },
  "additionalProperties": false
}
