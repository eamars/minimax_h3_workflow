{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "production-dag.schema.json",
  "type": "object",
  "required": ["artifact", "nodes", "edges"],
  "properties": {
    "artifact": {"$ref": "common-defs.schema.json#/$defs/artifact"},
    "nodes": {"type": "array", "items": {"type": "object", "required": ["job_id", "job_path", "state", "branch_id"]}},
    "edges": {"type": "array", "items": {"type": "object", "required": ["from", "to", "relation"], "properties": {"relation": {"enum": ["asset", "dependency", "continue", "bridge", "post"]}}}}
  }
}
