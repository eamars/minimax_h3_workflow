{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-state.schema.json",
  "type": "object",
  "required": ["artifact", "project_id", "state", "active_plan", "artifacts", "branches", "last_transition"],
  "properties": {
    "artifact": {"$ref": "common-defs.schema.json#/$defs/artifact"},
    "state": {"enum": ["NEW", "INTAKE_VALIDATED", "PLANNING", "PLAN_PREFLIGHT", "PLAN_READY", "COMPILING", "COMPILED", "KEYFRAME_PREP", "PRODUCING", "SEGMENT_QC", "REPAIRING", "ASSEMBLY_READY", "ASSEMBLING", "FINAL_QC", "DELIVERED"]},
    "active_plan": {"type": ["object", "null"]},
    "artifacts": {"type": "array"},
    "branches": {"type": "array"},
    "last_transition": {"type": ["object", "null"]}
  }
}
