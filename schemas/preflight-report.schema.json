{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "preflight-report.schema.json",
  "type": "object",
  "required": ["artifact", "verdict", "checks", "risk_register", "revision_requests"],
  "properties": {
    "artifact": {"$ref": "common-defs.schema.json#/$defs/artifact"},
    "verdict": {"enum": ["PASS", "REVISE", "BLOCKED"]},
    "checks": {"type": "array", "items": {"type": "object", "required": ["dimension", "status", "evidence"]}},
    "risk_register": {"type": "array"},
    "revision_requests": {"type": "array", "items": {"type": "object", "required": ["failure_code", "affected_ids", "smallest_upstream_artifact", "evidence"]}}
  }
}
